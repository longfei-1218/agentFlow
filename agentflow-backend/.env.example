# 复制为 .env 后按需修改。
# 注意：LLM 配置的优先级是「数据库（/api/settings/llm）> 这个文件 > 默认值」，
#      在界面里填过 Key 之后，这里再改就不生效了（先清空设置或留空 API Key 再改本文件）。

DATABASE_PATH=./data/agentflow.db

# LLM：留空则在界面上配置；填了就作为初始值
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini

# 执行引擎
MAX_STEPS=8
RUNNER=graph           # graph = LangGraph（默认：条件边/有界循环/checkpointer 续跑）
                       # loop  = R2 手写 Agent Loop（仅线性拓扑，留作对照）
                       # demo  = 确定性桩，不联网
DEMO_STEP_DELAY=0.05   # 节点间停顿（秒），想验证「停止」按钮可以调大到 0.5

CORS_ORIGINS=["http://localhost:5173"]
